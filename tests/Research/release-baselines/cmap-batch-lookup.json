  "correction": {
    "reader": "A stack-only CmapLookup borrows unchanged caller-owned bytes and validates its selected cmap on first actual scalar demand. Its validated descriptor is local to a synchronous batch; no copied bytes, shared cache, lock or retained snapshot metadata is added.",
    "query": "Validate the entire selected format-4/12 structure, then lower-bound search the ordered end codes/groups. Format-4 gaps, range/delta zero behavior, preferred encoding record selection and query-specific glyph-count checks are preserved. Format-12 group/glyph ranges remain globally validated before lookup.",
    "cancellation": "Every scalar retains CmapLookupProbe.Started and its cancellation check. Preparation checks cancellation during selection/validation. Failure/cancellation leaves the descriptor unprepared; completed metadata can be reused by later queries in the same batch.",
    "boundaries": "Independent static GetGlyphIndex calls create independent batches and revalidate each call. Font properties/bytes are accessed only at the original point of first mapping demand. Snapshot unchanged-byte and no-concurrent-disposal contracts remain unchanged.",
    "ownership": "All added state is fixed-size stack metadata. Existing geometry/decoder/coverage owners and reservations are unchanged; batches never cross await or escape into shared state."
  },
  "consumerReview": [
    {
      "scope": "Latin light glyph decoding",
      "owner": "OpenTypeFont.LatinLight.cs",
      "reuse": "One batch across non-base alias classification, alignment samples and stem sample mappings; standalone alignment sampling owns a separate batch."
