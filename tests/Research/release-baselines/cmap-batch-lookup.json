    },
    {
      "scope": "Acquisition and fallback coverage",
      "owner": "SvgFontSnapshot.Coverage.cs / SvgCanonicalText.cs",
      "reuse": "One batch across requested scalars for one candidate program; standalone per-candidate coverage reuses its batch for canonical components."
    },
    {
      "scope": "Glyph layout and hidden glyphs",
      "owner": "SvgGlyphLayout.cs",
      "reuse": "Lazy font-bound local batch, reset when physical font identity changes; existing repeated-scalar glyph/advance cache remains."
    },
    {
      "scope": "Legacy ligature matching",
      "owner": "OpenTypeFont.Ligatures.cs",
      "reuse": "One batch for following component mappings during one candidate search."
    },
    {
      "scope": "Single x-height query and independent callers",
      "owner": "SvgFontSnapshot.cs / OpenTypeFont.cs",
      "reuse": "Keep independent validation; these calls have no useful local scalar loop."
    }
  ],
