  "trace": [
    {
      "id": "P1",
      "status": "Open",
      "owner": "Shared gradient syntax, typed template graph, constant factory, ramps and sampling above.",
      "checks": "Default/empty/constant paints, exact stop/ramp arithmetic, native spread/alpha/shader banks, independent channels and ownership remain. The historical factory audit exposes 216 admitted residuals; do not claim this group closed."
    },
    {
      "id": "P2",
      "status": "Reviewed",
      "owner": "SvgPaintReference, SvgPaintResolver and header SvgPaintResourceSelection.",
      "checks": "SvgPaintFallbackTests, inert paint and font fallback checks retain missing/wrong-kind/valid-empty distinctions, independent channels, syntax, source/instance paths and errors. The eight-state original pattern-validity fixture distinguishes childless fallback from nonpainting children."
    },
    {
      "id": "P3",
      "status": "Reviewed",
      "owner": "SvgGradientCoordinates, SvgGradientSyntax and typed iterative registration in SvgDefinitionParser.",
      "checks": "GradientLength/Viewport/TemplateUnit/TemplateAttribute/Registration tests pin multiply-before-divide, per-axis inheritance, child definition/alias bases, cross-kind defaults, transform replacement and literal explicit units. Four viewport and template-unit fixtures retain independent native targets."
    },
    {
      "id": "P4",
      "status": "Reviewed",
      "owner": "Independent radial override inheritance and ValidateRadialFocalCircle in SvgDefinitionParser.",
      "checks": "Root/parser and template unit/attribute checks retain inside/tangent/escaping/zero-radius circles and focal defaults. Two unchanged inputs resolve percentages against the default 300x150 viewport, then fail containment; renamed tests now assert that actual reason. Native radial-axis and 192 exact historical alias inputs retain separate source/target identities."
    },
    {
      "id": "P5",
      "status": "Reviewed",
      "owner": "Stop syntax/cascade and element attribute policy; prepared stop storage and ramp.",
      "checks": "Stop style/precision/range/identity tests retain importance/source order, source-alpha/byte-color lanes, 256/257 stops, duplicate offsets, metadata bounds, reserved ownership and explicit unsupported style/unit/color locations. Stop-preparation and stop-range native banks protect pixels."
    },
    {
      "id": "P6",
      "status": "Reviewed",
      "owner": "Pattern syntax/coordinates, shared alias resolver/content replay and tile sampling.",
      "checks": "PatternContent/Coordinate/ViewBox/DefinitionLocation/DeferredPaint/ScopeBinding tests cover actual source owners and placement; repeat-address tests pin native float vectors. NestedPattern and ownership checks separate content depth/cycles from alias chains, including masks and shared DAG paths. Native pattern placement/content/viewBox/nesting/repeat controls retain their documented host authority."
    },
    {
      "id": "P7",
      "status": "Reviewed",
      "owner": "Header child selection, SvgPatternTemplate.Inherit and shared replay resolution.",
      "checks": "Pattern template/display and supplied-font override/resource/reachability checks distinguish local element roles from comments/text, repaired dimensions from effective zero, and hidden template from hidden alias. Pattern inheritance/source-selection and original fallback-validity native controls preserve those graphs."
    }
  ],
