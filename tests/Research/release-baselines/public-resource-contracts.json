    {
      "area": "Borrowed font-program lifetime",
      "implementation": "../../../src/Lokad.Svg/Fonts/SvgFontSnapshot.cs",
      "witness": "../../Lokad.Svg.Tests/SvgFontProgramSourceTests.cs",
      "correction": "Returned memory stays valid and immutable for every consumer. Snapshots borrow it until disposal after readers finish. Source owners remain responsible for program storage; snapshot charges cover their own metadata."
    },
    {
      "area": "Acquisition-result reachability and ownership",
      "implementation": "../../../src/Lokad.Svg/Fonts/SvgFontProgramSource.cs",
      "witness": "../../Lokad.Svg.Tests/SvgFontProgramSourceTests.cs",
      "correction": "A resolution retains the source reference without owning its storage/cache. Acquisition and later snapshot creation both verify bytes; borrowed snapshots require immutable input."
    },
    {
      "area": "Shared resource retries",
      "implementation": "../../../src/Lokad.Svg/Fonts/SvgHttpFontPackResolver.cs",
      "witness": "../../Lokad.Svg.Tests/OpenTypeFontTests.HttpResolver.cs",
      "correction": "The configured deadline and attempts apply to one shared resource load. Transient transport errors and selected HTTP responses can retry. Canceling one waiter leaves shared acquisition running; shared cancellation, invalid data and admission refusal do not start a retry."
    },
    {
      "area": "Allowance admission",
      "implementation": "../../../src/Lokad.Svg/Memory/IMemoryBudget.cs",
      "witness": "../../Lokad.Svg.Tests/RenderBudgetTests.cs",
      "correction": "Thread-safe admission does not wait/retry for allowance or allocate the storage being admitted. This does not prohibit reservation metadata or ordinary synchronization."
    },
    {
      "area": "Limits and font traversal",
      "implementation": "../../../src/Lokad.Svg/Fonts/SvgFontPackCatalog.cs",
      "witness": "../../Lokad.Svg.Tests/SvgFontPackCatalogTests.cs",
      "correction": "LimitExceeded describes structural, numerical, size and memory bounds. Provenance/selection traversals check cancellation; ignored nodes still count against structural limits. No work quota is introduced."
    },
