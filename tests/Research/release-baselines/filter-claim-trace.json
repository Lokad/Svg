      ],
      "inspected": "The streaming definition builder admits the finite primitive/input/operator/unit/region/color-space subset and defers dormant-definition errors. Matrix syntax enforces type/arity/finite float coefficients; defaults and luminance-to-alpha are distinct. Evaluation unpremultiplies, evaluates straight channels, clamps and repremultiplies. Positive alpha bias extends primitive-region output independently of source ink.",
      "checks": {
        "tests/Lokad.Svg.Tests/SvgFilterColorMatrixTests.cs": [
          "Matrix_evaluates_straight_channels_and_repremultiplies_after_clamping",
          "Output_bounds_distinguish_input_ink_from_alpha_generated_across_the_primitive_region",
          "Omitted_values_keep_the_identity_default",
          "Matrix_arity_is_checked_at_the_definition_boundary",
          "Scalar_modes_require_one_finite_unitless_number"
        ],
        "tests/Lokad.Svg.Tests/SvgFilterLengthTests.cs": [
          "Fixed_region_and_primitive_lengths_are_bounded_before_coordinate_resolution",
          "Percentage_lengths_keep_their_viewport_relative_domain"
        ]
