  "sourceBaseline": "fe78feda96a9eb7b22b4ecd49463f6d77aa2c923",
  "scope": "Admit non-executing SVG script elements with character-data content in static conversion. One bounded consumer serves preparation, paint/font discovery, geometric leaves, live text, retained text and document lowering. Preserve switch choice, pattern content inheritance and lexical node accounting. No script runtime, URL resolution, layout algorithm or public signature change.",
  "specifications": [
    "https://www.w3.org/TR/SVG2/interact.html#ScriptElement",
    "https://www.w3.org/TR/SVG2/conform.html#static-mode"
  ],
  "implementation": [
    "../../../src/Lokad.Svg/Parsing/SvgStructuralAdmission.cs",
    "../../../src/Lokad.Svg/Parsing/SvgRetainedTextSource.cs",
    "../../../src/Lokad.Svg/Parsing/SvgRenderedLeafParser.cs"
  ],
  "sharedModel": [
    "The opening element is already counted. The borrowed reader consumes the subtree, meters child nodes, absolute depth, attributes and cancellation, and leaves its closing element. It retains or interprets no body or URL.",
    "Element children are reported as unsupported; preparatory scans cannot activate their styles, resources or fonts. Selected lowering owns admission. Foreign script namespaces remain distinct.",
    "Scripts keep their authored switch slot and override pattern template content as authored children; consuming them does not change outer scope state.",
    "Retained text stores an empty script marker with original source location. Bodies consume neither rendered-text allowance nor retained string storage. Markers preserve original node counts and surrounding text nodes.",
    "Direct text and all three callers share SvgRenderLimits and absolute-depth validation, replacing separately passed depth/attribute primitives."
  ],
  "mechanisms": {
    "test": "../../Lokad.Svg.Tests/SvgStaticScriptTests.cs",
    "cases": 17,
    "roles": [
