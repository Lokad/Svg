  "model": {
    "rule": "Groups inside clipPath are dormant definitions, not flattened clip contours. Their IDs and descendant IDs remain ordinary use targets. A selected leaf excludes enclosing transforms; a selected group retains its own transform. The existing resource-use replay already treats container references as contributing no clip contour.",
    "implementation": "Admit clip-child groups through the existing dormant-group builder and ownership transfer. Font indexing classifies clipPath as a definition scope, keeping descendants addressable while ordinary resource traversal leaves text inactive. No source-name exception, anonymous-only shortcut, new DOM collector or geometry framework.",
    "specification": "https://www.w3.org/TR/css-masking-1/#elementdef-clippath",
    "interpretation": "The specification distinguishes shape silhouettes from container references. Independent pinned native controls establish ignored group contribution, valid sibling survival and ordinary ID-selection behavior; no claim of general browser conformance.",
    "remainingBoundaries": "Direct line/text clip children, XML clipPath transform/fill/opacity, unsupported referenced geometry and retained-group mask restrictions keep their existing explicit admission boundaries."
  },
  "responsibilities": {
    "mechanisms": "../../Lokad.Svg.Tests/SvgClipChildRoleTests.cs",
