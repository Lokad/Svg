  "finding": "Three first-gate originals use zero-point dash offsets. Root and marker length parsing duplicated unit factors, while stroke width, entries, offsets and zero-width selection only admitted bare/px tokens.",
  "sharedModel": [
    "SvgCssLength splits fixed CSS units once. Roots, markers and stroke metrics reuse factors; marker float narrowing remains before multiplication and root/stroke numeric admission remains in its caller.",
    "Stroke width, dash entries and offsets convert before finite/range admission. Negative offsets remain valid, negative entries remain MalformedInput, and negative widths remain unsupported.",
    "Zero-width selection uses the same fixed conversion as construction, preserving unused-font and inherited missing-paint suppression.",
    "No zero-only exception, new owner, retained array, closure, public API or alternate geometry path. Percent/font-relative stroke metrics remain unsupported until their bases are represented."
  ],
  "specifications": [
    "https://www.w3.org/TR/SVG/painting.html#StrokeDashoffsetProperty",
    "https://www.w3.org/TR/css-values-4/#absolute-lengths"
  ],
  "coverage": {
    "mechanisms": {
      "file": "../../Lokad.Svg.Tests/SvgFixedStrokeLengthTests.cs",
      "cases": 39,
      "responsibilities": "Fixed units, signed offsets, converted numeric bounds, mixed/odd/all-zero arrays, lexical/nonfinite rejection, physical-zero selection and root quarter-mm lengths."
    },
    "failingBefore": {
      "selection": "Initial31 direct cases",
      "failed": 16,
      "passed": 15,
      "qualification": "Eight more direct cases were added for quarter-mm/root and zero selection after the implementation; no claim they were part of the initial failing-before run."
    },
    "contracts": [
      {
        "file": "../../Lokad.Svg.Tests/SvgTextStrokeTests.cs",
        "newCases": 1,
        "responsibility": "Physical-zero child stroke requests no unused font; the existing provider/source counters and discovery/conversion assertions remain."
      },
      {
