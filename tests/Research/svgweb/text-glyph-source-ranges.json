  "sourceBaseline": "f1e267ac142fa79e1edcd203381f29f06f856e85",
  "status": "CLOSED: explicit source ranges for existing ligature shaping. OPEN: canonical normalization, glyph clusters, ccmp substitution and mark attachment; no additional text or font admission.",
  "scope": {
    "newMechanismCases": 1,
    "strengthenedOwnershipContracts": 1,
    "referenceBytesChanged": 0,
    "newPublicTypes": 0,
    "newRuntimeDependencies": 0,
    "newResourceOwners": 0,
    "hostedSvgBodiesRetained": 0,
    "sourceAttributeValuesRetained": 0
  },
  "model": {
    "sourceUnits": "Half-open emitted UTF-16 intervals after case projection; original SVG addresses still resolve before projection.",
    "ordinaryRuns": "One-to-one cmap runs borrow the input string, allocating no source scratch.",
    "substitutedRuns": "One transient array records explicit source start/end per glyph; spacing, filtered pair traversal and absolute positioning consume those intervals.",
    "memory": "Source-array capacity is the input scalar count N. Charge changes from 32+4*N to 32+8*N bytes only when a ligature is formed. The same reservation lifetime ends in the layout finally block; no array is retained by the scene.",
    "boundaries": "Physical face/size, paint, spacing, absolute position, node/native font scale and path rules stay unchanged.",
    "limitations": "Current admitted glyph ranges remain monotone and disjoint. They do not yet represent reordered source association or multiple glyphs sharing a cluster. No guard was removed, no offset guessed and no mark rendering claim made."
  },
  "sourceLfSha256": {
    "src/Lokad.Svg/Fonts/SvgGlyphLayout.cs": "c7088da592dda197ef93185fab2ba98566ea7c52290d5800939baaca781e0058",
    "tests/Lokad.Svg.Tests/OpenTypeFontLigatureTests.cs": "fae1effbfd300c0ce3118a1908b27d4d0d0e489fff68894d08b84b4a91784bd3"
  },
  "coverage": {
    "mechanism": "The new case forms a ligature after a supplementary scalar, then checks separate UTF-16 absolute resets and selected physical faces. Existing filtered-GPOS cases cover lookahead over ligatures/supplementary input, spacing/font boundaries and last/sole glyph rejection.",
    "ownership": "The existing ligature contract now measures the peak, refuses at peak-minus-one, checks zero live bytes, retries at exact peak, and retains cancellation cleanup. No fixture/API matrix added.",
    "rendering": "Existing canonical text, mixed-run and shaping-interval images; all references/tolerances unchanged."
  },
