  "controlQualification": "One fresh healthy/profile-cleaned native original and mapped companion per context/host; exploratory, not reference admission. All six native pairs and their integer-root library companions are exact on both platforms.",
  "models": [
    {
      "id": "scaled-layout",
      "layout": "floor(float(logicalAxis * outputScale) * 64) / 64",
      "projection": "round(logicalAxis * outputScale) / layoutAxis",
      "finding": "Matches the six CSS image contexts but folding output scale into authored drawing stages changes established text paint rounding. Scimitar also exposes the independent paintless-fill admission defect.",
