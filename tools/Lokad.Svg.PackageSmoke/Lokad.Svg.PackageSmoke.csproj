<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lokad.Svg" Version="$(LokadSvgPackageVersion)" />
    <None Update="assets/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
