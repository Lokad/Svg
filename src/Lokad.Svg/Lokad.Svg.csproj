<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Lokad.Svg</AssemblyName>
    <RootNamespace>Lokad.Svg</RootNamespace>
    <PackageId>Lokad.Svg</PackageId>
    <Version>0.3.0-preview.1</Version>
    <Authors>Lokad</Authors>
    <Description>A pure managed SVG to PNG renderer for .NET.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Lokad/Svg</PackageProjectUrl>
    <PackageReleaseNotes>Development preview. See https://github.com/Lokad/Svg/blob/master/CHANGELOG.md for implemented changes and scope.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Lokad/Svg</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>svg;png;rendering</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="" Link="LICENSE.txt" />
    <None Include="../../THIRD_PARTY_NOTICES.txt" Pack="true" PackagePath="" Link="THIRD_PARTY_NOTICES.txt" />
    <None Include="../../licenses/FreeType/FTL.TXT" Pack="true" PackagePath="licenses/FreeType/" Link="licenses/FreeType/FTL.TXT" />
    <None Include="../../README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="" Link="CHANGELOG.md" />
  </ItemGroup>
  <Target Name="EnforceReleasePackageConfiguration" BeforeTargets="GenerateNuspec"
          Condition="'$(Configuration)' != 'Release' and '$(AllowNonReleasePackage)' != 'true'">
    <Error Text="NuGet packages must be produced with -c Release. Pass /p:AllowNonReleasePackage=true only for troubleshooting." />
  </Target>
</Project>
