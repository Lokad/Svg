<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Lokad.Svg</AssemblyName>
    <RootNamespace>Lokad.Svg</RootNamespace>
    <PackageId>Lokad.Svg</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>Lokad</Authors>
    <Description>A pure managed SVG to PNG renderer for .NET.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Lokad/Lokad.Svg</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>svg;png;rendering</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="" Link="LICENSE.txt" />
    <None Include="../../THIRD_PARTY_NOTICES.txt" Pack="true" PackagePath="" Link="THIRD_PARTY_NOTICES.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>
</Project>
