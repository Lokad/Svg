<Project>
  <PropertyGroup>
    <!-- Restore both test/tool targets; build and test net11.0 unless explicitly selected. -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(MSBuildProjectName)' != 'Lokad.Svg'">net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
